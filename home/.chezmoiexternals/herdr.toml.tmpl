# Herdr Annotate is linked, never installed through upstream build hooks.
# Keep exact disabled: the after-script owns bin/ symlinks to pinned mise binaries.
# renovate: datasource=github-digest depName=plannotator/herdr-annotate currentValue=main
{{ $herdrAnnotateRef := "c5e565e9bdbb52d152ad15169f38ed8bae31b610" -}}

{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
[".local/share/herdr-annotate"]
  type = "archive"
  url = "https://github.com/plannotator/herdr-annotate/archive/{{ $herdrAnnotateRef }}.tar.gz"
  stripComponents = 1
  include = ["*/herdr-plugin.toml", "*/herdr-annotate.version", "*/plannotator-tui.version"]
{{ end -}}

# vi: ft=toml
