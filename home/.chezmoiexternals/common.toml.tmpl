#  ╭──────────────────────────────────────────────────────────╮
#  │ file                                                     │
#  ╰──────────────────────────────────────────────────────────╯
[".face"]
    type = "file"
    url = "https://gravatar.com/avatar/{{ .me.gravatar.id }}?s=2048"

# opencode-tree is pinned to a reviewed fork commit instead of installing the
# upstream npm package by name. Bump this ref only after reviewing the fork diff.
{{ $opencodeTreeRef := "ee2b80f172227bf0a2858cbc28beb8d97cd0754b" -}}

[".local/share/opencode-tree-src"]
    type = "archive"
    url = "https://github.com/scottames/opencode-tree/archive/{{ $opencodeTreeRef }}.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

# Theme fragments for k9s, fuzzel, atuin, yazi, hyprlock, waybar, alacritty and
# pi are generated from .chezmoidata/themes.toml instead of vendored, so the
# upstream archives that used to land here are gone. They were `exact = true`,
# which would delete the `current` symlinks theme-set writes into these dirs.
#
# bat needs no theme externals at all: 0.26 bundles the Catppuccin themes, and
# Aura's is vendored at private_dot_config/bat/themes/aura/ because upstream's
# is broken (see the comment at the top of that file). bat scans themes/
# recursively and names each theme after its filename stem, so it lands as
# `aura-theme`.

#  ╭──────────────────────────────────────────────────────────╮
#  │ git-repo                                                 │
#  │ | pub                                                    │
#  ╰──────────────────────────────────────────────────────────╯
[".config/alacritty/alacritty-themes"]
    type = "git-repo"
    url = "https://github.com/rajasegar/alacritty-themes.git"
    refreshPeriod = "168h"

