{{- /* extends "droid" is the local base profile alongside this one, not a
       registry pack: the Nono registry has no nolabs-ai/droid pack. Droid
       spawns and signals its own children (droid exec subagents, background
       processes), so it needs signal_mode allow_same_sandbox via "security". */ -}}
{{- includeTemplate "nono-local-profile" (dict
      "ctx" .
      "extends" "droid"
      "name" "droid-local"
      "version" "0.1.0"
      "description" "Droid with local mise runtime access and external git include access"
      "security" true
) -}}
