{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["./herdr-opencode"],
  "theme": {
    "name": "aura"
  },
  "prompt": {
    "paste": "full"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "keybinds": {
    "app.exit": "ctrl+c,<leader>q",
    "command.palette.show": "ctrl+.",
    "leader": "ctrl+o",
    "prompt.editor": "<leader>e",
    "theme.switch": "<leader>t",
    "session.sidebar.toggle": "<leader>b",
    "session.new": "<leader>n",
    "session.list": "<leader>l",
    "session.compact": "<leader>c",
    "model.list": "<leader>m",
    "agent.list": "<leader>a",
    "prompt.submit": "return"
  },
  "tabs": {
    "layout": "horizontal",
    "enabled": false,
    "scope": "cwd"
  }
}
