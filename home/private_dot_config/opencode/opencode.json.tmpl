{{- $workNotebook := "" -}}
{{- if hasKey . "work" -}}
{{-   $work := index . "work" -}}
{{-   if hasKey $work "notebook" -}}
{{-     $workNotebook = index $work "notebook" -}}
{{-   end -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "plugins": ["./local-plugins/nono-v2"],
  "default_agent": "plan",
  "agents": {
    "general": {
      "model": "openai/gpt-5.6-terra"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna"
    },
    "scout": {
      "model": "openai/gpt-5.6-terra"
    },
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "instructions": [],
  "mcp": {
    "servers": {
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp",
        "disabled": false,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:TAVILY_API_KEY}"
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "/bin/ls*", "effect": "allow" },
    { "action": "shell", "resource": "/usr/bin/ls*", "effect": "allow" },
    { "action": "shell", "resource": "actionlint*", "effect": "allow" },
    { "action": "shell", "resource": "bash {{ .chezmoi.homeDir }}/.opencode/skills/**", "effect": "allow" },
    { "action": "shell", "resource": "bash {{ .chezmoi.homeDir }}/.config/opencode/skills/**", "effect": "allow" },
    { "action": "shell", "resource": "bash \"{{ .chezmoi.homeDir }}/.opencode/skills/**", "effect": "allow" },
    { "action": "shell", "resource": "bash \"{{ .chezmoi.homeDir }}/.config/opencode/skills/**", "effect": "allow" },
    { "action": "shell", "resource": "cargo build*", "effect": "allow" },
    { "action": "shell", "resource": "cargo check*", "effect": "allow" },
    { "action": "shell", "resource": "cargo doc*", "effect": "allow" },
    { "action": "shell", "resource": "cargo info*", "effect": "allow" },
    { "action": "shell", "resource": "cargo run*", "effect": "allow" },
    { "action": "shell", "resource": "cargo test*", "effect": "allow" },
    { "action": "shell", "resource": "cat*", "effect": "allow" },
    { "action": "shell", "resource": "command grep*", "effect": "allow" },
    { "action": "shell", "resource": "command ls*", "effect": "allow" },
    { "action": "shell", "resource": "command rg*", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "git branch*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git ls*", "effect": "allow" },
    { "action": "shell", "resource": "git mv*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git worktree list*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view*", "effect": "allow" },
    { "action": "shell", "resource": "gh run view*", "effect": "allow" },
    { "action": "shell", "resource": "gh release view*", "effect": "allow" },
    { "action": "shell", "resource": "gh stack view --json*", "effect": "allow" },
    { "action": "shell", "resource": "go build*", "effect": "allow" },
    { "action": "shell", "resource": "go list*", "effect": "allow" },
    { "action": "shell", "resource": "go mod tidy*", "effect": "allow" },
    { "action": "shell", "resource": "go run*", "effect": "allow" },
    { "action": "shell", "resource": "go test*", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "gt ls*", "effect": "allow" },
    { "action": "shell", "resource": "helm get*", "effect": "allow" },
    { "action": "shell", "resource": "helm history*", "effect": "allow" },
    { "action": "shell", "resource": "helm lint*", "effect": "allow" },
    { "action": "shell", "resource": "helm template*", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl desc*", "effect": "allow" },
    { "action": "shell", "resource": "kubectl get*", "effect": "allow" },
    { "action": "shell", "resource": "kubectl list*", "effect": "allow" },
    { "action": "shell", "resource": "mise run *", "effect": "allow" },
    { "action": "shell", "resource": "*npm ci*", "effect": "allow" },
    { "action": "shell", "resource": "*npm run build*", "effect": "allow" },
    { "action": "shell", "resource": "*npm run test*", "effect": "allow" },
    { "action": "shell", "resource": "*npm test*", "effect": "allow" },
    { "action": "shell", "resource": "pytest *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "test -f*", "effect": "allow" },
    { "action": "shell", "resource": "thts init --check", "effect": "allow" },
    { "action": "shell", "resource": "thts agent-instructions", "effect": "allow" },
    { "action": "shell", "resource": "thts status", "effect": "allow" },
    { "action": "shell", "resource": "thts sync*", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "trunk check*", "effect": "allow" },
    { "action": "shell", "resource": "trunk fmt*", "effect": "allow" },
    { "action": "shell", "resource": "uv run pytest*", "effect": "allow" },
    { "action": "shell", "resource": "uv run python -m pytest", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "doom_loop", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "{{ .home.ntbk_dir }}/**", "effect": "allow" },
{{- if ne $workNotebook "" }}
    { "action": "external_directory", "resource": "{{ $workNotebook }}/**", "effect": "allow" },
{{- end }}
    { "action": "external_directory", "resource": "~/.agents/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cargo/registry/src**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.claude/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.codex/skills/", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.opencode/skills/**", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "brainstorming", "effect": "allow" },
    { "action": "skill", "resource": "ce-*", "effect": "allow" },
    { "action": "skill", "resource": "dispatching-parallel-agents", "effect": "allow" },
    { "action": "skill", "resource": "document-review", "effect": "allow" },
    { "action": "skill", "resource": "executing-plans", "effect": "allow" },
    { "action": "skill", "resource": "find-docs", "effect": "allow" },
    { "action": "skill", "resource": "git-commit", "effect": "allow" },
    { "action": "skill", "resource": "gh-stack", "effect": "allow" },
    { "action": "skill", "resource": "graphite", "effect": "allow" },
    { "action": "skill", "resource": "handoff", "effect": "allow" },
    { "action": "skill", "resource": "herdr", "effect": "allow" },
    { "action": "skill", "resource": "ponytail", "effect": "allow" },
    { "action": "skill", "resource": "requesting-code-review", "effect": "allow" },
    { "action": "skill", "resource": "resolve-pr-feedback", "effect": "allow" },
    { "action": "skill", "resource": "subagent-driven-development", "effect": "allow" },
    { "action": "skill", "resource": "systematic-debugging", "effect": "allow" },
    { "action": "skill", "resource": "test-driven-development", "effect": "allow" },
    { "action": "skill", "resource": "thts*", "effect": "allow" },
    { "action": "skill", "resource": "using-superpowers", "effect": "allow" },
    { "action": "skill", "resource": "verification-before-completion", "effect": "allow" },
    { "action": "skill", "resource": "worktrunk", "effect": "allow" },
    { "action": "skill", "resource": "writing-plans", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],
  "share": "disabled"
}
