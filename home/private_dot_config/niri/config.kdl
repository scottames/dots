environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

include "input.kdl"
include "outputs.kdl"
include "layout.kdl"

spawn-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include "window-rules.kdl"
include "binds.kdl"

// Theme colors override the structural layout settings above.
include optional=true "~/.config/themes/current/niri.kdl"
