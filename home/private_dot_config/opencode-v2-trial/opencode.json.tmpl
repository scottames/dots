{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",
  "experimental": {
    "disable_paste_summary": true
  },
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-terra"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna"
    },
    "scout": {
      "model": "openai/gpt-5.6-terra"
    },
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  },
  "instructions": [],
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_KEY}"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask"
    },
    "edit": "ask",
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.claude/skills/**": "allow",
      "~/.codex/skills/": "allow",
      "~/.config/opencode-v2-trial/skills/**": "allow",
      "~/.opencode/skills/**": "allow"
    },
    "skill": {
      "*": "ask",
      "find-docs": "allow",
      "git-commit": "allow",
      "gh-stack": "allow",
      "herdr": "allow",
      "ponytail": "allow",
      "thts*": "allow",
      "worktrunk": "allow"
    },
    "webfetch": "ask",
    "websearch": "allow"
  },
  "server": {
    "hostname": "127.0.0.1",
    "mdns": false
  },
  "share": "disabled"
}
