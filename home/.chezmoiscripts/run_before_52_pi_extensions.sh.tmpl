#!/usr/bin/env bash

# Installs the reviewed, locked Pi extensions into a staged local build and
# atomically selects it, so incomplete installs cannot disrupt active sessions.
set -eufo pipefail

source_dir="{{ joinPath .chezmoi.sourceDir "dot_local/share/private_pi-extensions" }}"
extensions_dir="{{ joinPath .chezmoi.homeDir ".local/share/pi-extensions" }}"
cache_dir="{{ joinPath .chezmoi.homeDir ".cache/pi-extensions/npm" }}"
# Bump the prefix when the post-install package layout changes.
build_hash="{{ printf "pi-extension-layout-v4:%s" (include "dot_local/share/private_pi-extensions/package-lock.json") | sha256sum }}"
build_dir="${extensions_dir}/installs/${build_hash}"
current_link="${extensions_dir}/current"
staging_dir=''
temporary_link=''

cleanup() {
  [[ -z ${staging_dir} ]] || rm -rf -- "${staging_dir}"
  [[ -z ${temporary_link} ]] || rm -f -- "${temporary_link}"
}
trap cleanup EXIT

[[ -f ${source_dir}/package.json ]] || { printf 'Pi extension manifest is missing\n' >&2; exit 1; }
[[ -f ${source_dir}/package-lock.json ]] || { printf 'Pi extension lockfile is missing\n' >&2; exit 1; }
command -v mise >/dev/null 2>&1 || { printf 'mise is unavailable\n' >&2; exit 1; }

mkdir -p "${extensions_dir}/installs" "${cache_dir}"

if [[ ! -d ${build_dir}/node_modules ]]; then
  [[ ! -e ${build_dir} ]] || { printf 'Pi extension build is incomplete: %s\n' "${build_dir}" >&2; exit 1; }
  staging_dir="$(mktemp -d "${extensions_dir}/installs/.${build_hash}.XXXXXX")"
  cp "${source_dir}/package.json" "${source_dir}/package-lock.json" "${staging_dir}/"

  extension_package_names="$(
    mise exec -- node - "${staging_dir}/package.json" <<'NODE'
const fs = require('node:fs');

const manifest = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
for (const name of Object.keys(manifest.dependencies)) console.log(name);
NODE
  )"
  [[ -n ${extension_package_names} ]] || { printf 'Pi extension manifest has no dependencies\n' >&2; exit 1; }
  mapfile -t extension_packages <<<"${extension_package_names}"

  # Extensions never run lifecycle scripts while this reviewed lock is installed.
  mise exec -- npm --prefix "${staging_dir}" ci \
    --registry=https://registry.npmjs.org/ \
    --legacy-peer-deps \
    --ignore-scripts \
    --omit=dev \
    --no-audit \
    --no-fund \
    --cache "${cache_dir}"

  for package in "${extension_packages[@]}"; do
    [[ -d ${staging_dir}/node_modules/${package} ]] || { printf 'Pi extension is missing after install: %s\n' "${package}" >&2; exit 1; }
  done

  # Pi resolves each configured local package from its own module root. npm
  # hoists some pi-starship production dependencies to the enclosing install,
  # so copy them into the package's scoped node_modules directory.
  starship_dir="${staging_dir}/node_modules/@narumitw/pi-starship"
  mapfile -t starship_dependencies < <(
    mise exec -- node - "${starship_dir}/package.json" <<'NODE'
const fs = require('node:fs');

const manifest = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
for (const name of Object.keys(manifest.dependencies ?? {})) console.log(name);
NODE
  )
  for dependency in "${starship_dependencies[@]}"; do
    source_dependency="${staging_dir}/node_modules/${dependency}"
    target_dependency="${starship_dir}/node_modules/${dependency}"
    [[ -e ${target_dependency} ]] && continue
    [[ -d ${source_dependency} ]] || { printf 'Pi-starship dependency is missing after install: %s\n' "${dependency}" >&2; exit 1; }
    cp -R "${source_dependency}" "${target_dependency}"
  done

  # Pi's Jiti loader cannot resolve pi-starship's generated createRequire()
  # bridge. Bundle its dependencies beside every generated chunk and replace
  # that bridge with a static TOML import, which Pi resolves correctly.
  mise exec -- node - "${starship_dir}" <<'NODE'
const fs = require('node:fs');
const path = require('node:path');

const starshipDir = process.argv[2];
const manifest = JSON.parse(fs.readFileSync(path.join(starshipDir, 'package.json'), 'utf8'));
const chunksDir = path.join(starshipDir, 'dist', 'chunks');
const chunksNodeModules = path.join(chunksDir, 'node_modules');
const bridge = `var require2 = createRequire(import.meta.url);\nvar parseTomlImplementation;\nfunction parseToml(document) {\n  parseTomlImplementation ??= require2("smol-toml").parse;\n  return parseTomlImplementation(document);\n}`;
const replacement = `function parseToml(document) {\n  return parseTomlImplementation(document);\n}`;
const chunkPath = fs.readdirSync(chunksDir)
  .filter((name) => name.endsWith('.js'))
  .map((name) => path.join(chunksDir, name))
  .find((candidate) => fs.readFileSync(candidate, 'utf8').includes(bridge));

if (!chunkPath) throw new Error('pi-starship TOML bridge chunk was not found');
let chunk = fs.readFileSync(chunkPath, 'utf8');
if (!chunk.includes('import { createRequire } from "node:module";')) {
  throw new Error('pi-starship TOML bridge import was not found');
}
chunk = chunk.replace(
  'import { createRequire } from "node:module";',
  'import { parse as parseTomlImplementation } from "smol-toml";',
).replace(bridge, replacement);
fs.writeFileSync(chunkPath, chunk);

for (const dependency of Object.keys(manifest.dependencies ?? {})) {
  const source = path.join(starshipDir, 'node_modules', dependency);
  const target = path.join(chunksNodeModules, dependency);
  if (!fs.statSync(source).isDirectory()) throw new Error(`pi-starship dependency is missing: ${dependency}`);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.cpSync(source, target, { recursive: true });
}
NODE

  mv "${staging_dir}" "${build_dir}"
  staging_dir=''
fi

# Switch only after a complete build exists; prior builds stay available to running Pi sessions.
temporary_link="${extensions_dir}/.current.$$"
ln -s "${build_dir}" "${temporary_link}"
mise exec -- node -e '
const fs = require("node:fs");
fs.renameSync(process.argv[1], process.argv[2]);
' "${temporary_link}" "${current_link}"
temporary_link=''

# vi: ft=bash
