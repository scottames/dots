#!/usr/bin/env bash

set -e

# Colors
# red='\033[0;31m'
# green='\033[0;32m'
# blue='\033[0;34m'
magenta='\033[0;35m'
cyan='\033[0;36m'
yellow='\033[0;33m'
clear='\033[0m'
print_info() { printf "\n${yellow}⚡ ${magenta}%s${clear}\n" "${@}"; }
print_success() { printf "\n${cyan}🎉 %s${clear}\n\n" "${@}"; }
# print_err() { printf "\n${red}💥 %s${clear}\n\n" "${@}"; }
print_warn() { printf "\n${yellow}⚠  %s${clear}\n\n" "${@}"; }

# https://patorjk.com/software/taag/#p=display&f=ANSI%20Shadow&t=bat
echo '
   ██████╗  █████╗ ████████╗
   ██╔══██╗██╔══██╗╚══██╔══╝
   ██████╔╝███████║   ██║
   ██╔══██╗██╔══██║   ██║
   ██████╔╝██║  ██║   ██║
🦇 ╚═════╝ ╚═╝  ╚═╝   ╚═╝
'

# Rebuild whenever the vendored theme changes. Hashing the *source* rather than
# the deployed copy means this fires on the same apply that installs it, not the
# one after.
# {{ include "private_dot_config/bat/themes/aura/aura-theme.tmTheme" | sha256sum }}

if command -v bat; then
  print_info "rebuilding 🦇 bat cache"
  bat cache --build
else
  print_warn "no bat, skipping cache build"
fi

