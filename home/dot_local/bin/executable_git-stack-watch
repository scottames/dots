#!/usr/bin/env bash

interval="${1:-3}"

cleanup() {
  printf '\033[?25h'
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

printf '\033[?25l\033[2J'
while :; do
  printf '\033[H'
  output=

  if [[ ${GH_STACK_ENABLED-} == true ]] && command -v gh >/dev/null 2>&1 && gh stack --help >/dev/null 2>&1; then
    if ! output="$(GIT_PAGER=cat PAGER=cat gh stack view --short 2>/dev/null)"; then
      output=
    fi
  elif [[ ${GRAPHITE_ENABLED-} == true ]] && command -v gt >/dev/null 2>&1; then
    if ! output="$(GIT_PAGER=cat PAGER=cat BAT_PAGER=cat gt ls 2>/dev/null)"; then
      output=
    fi
  fi

  if [[ -z ${output} ]]; then
    output="$(GIT_PAGER=cat PAGER=cat BAT_PAGER=cat git --no-pager log --oneline --decorate --graph -20 2>&1 || true)"
  fi

  while IFS= read -r line; do
    printf '%s\033[K\n' "${line}"
  done <<<"${output}"
  printf '\033[J'
  sleep "${interval}"
done
