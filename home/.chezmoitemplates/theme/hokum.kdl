name "Current"
theme "capsule"

tokens {
    fill "{{ .bg }}"
    text "{{ .fg }}"
    muted "{{ .muted }}"
    faint "{{ .muted }}"
    border 1 "{{ .accent }}"
    accent "{{ .accent }}"
}

rule urgency="critical" {
    tokens {
        border 1 "{{ .orange }}"
        accent "{{ .orange }}"
    }
}
