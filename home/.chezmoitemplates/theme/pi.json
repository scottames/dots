  "colors": {
    "accent": "accent",
    "border": "border",
    "borderAccent": "cyan",
    "borderMuted": "dim",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "muted",
    "dim": "dim",
    "text": "",
    "thinkingText": "muted",
    "selectedBg": "selected",
    "userMessageBg": "panel",
    "userMessageText": "",
    "customMessageBg": "panelAlt",
    "customMessageText": "",
