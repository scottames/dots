{
  "$schema": "https://raw.githubusercontent.com/badlogic/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "current",
  "vars": {
    "bg": "{{ .bg }}",
    "panel": "{{ .bg_float }}",
    "panelAlt": "{{ .bg_dim }}",
    "selected": "{{ .selection }}",
    "border": "{{ .border }}",
    "accent": "{{ .accent }}",
    "cyan": "{{ .cyan }}",
    "green": "{{ .green }}",
    "red": "{{ .red }}",
    "yellow": "{{ .yellow }}",
    "orange": "{{ .orange }}",
    "purple": "{{ .pink }}",
    "text": "{{ .fg }}",
    "muted": "{{ .muted }}",
    "dim": "{{ .fg_dim }}",
    "toolSuccessBg": "{{ .bg_alt }}",
    "toolErrorBg": "{{ .bg_alt }}"
