name: scta
dependencies:
{{- $packageRoot := joinPath .home.src_github_dir ".agents/main/packages" }}
{{- $packageNames := list
  "ctx7"
  "gh-stack"
  "global"
  "herdr"
  "humanlayer"
  "ponytail"
}}
{{- range $name := $packageNames }}
{{- $packagePath := joinPath $packageRoot $name }}
{{- if stat $packagePath }}
- name: {{ $name }}
  base: {{ $packagePath }}
{{- end }}
{{- end }}
- name: gh@schpet/linear-cli/skills/linear-cli
  base: {{ joinPath .chezmoi.homeDir ".openpackage/packages/linear-cli" }}
dev-dependencies: []
