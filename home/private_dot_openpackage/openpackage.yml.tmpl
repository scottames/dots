name: scta
dependencies:
{{- $packageRoot := joinPath .home.src_github_dir ".agents/main/packages" }}
{{- $packageNames := list
  "ctx7"
  "gh-stack"
  "global"
  "herdr"
  "ponytail"
  "worktrunk"
}}
{{- range $name := $packageNames }}
{{- $packagePath := joinPath $packageRoot $name }}
{{- if stat $packagePath }}
- name: {{ $name }}
  base: {{ $packagePath }}
{{- end }}
{{- end }}
{{- $linearCliVersion := index (fromToml (include "../mise/config.toml")).tools "github:schpet/linear-cli" }}
- name: gh@schpet/linear-cli/skills/linear-cli
  url: https://github.com/schpet/linear-cli.git#{{ $linearCliVersion }}
  path: skills/linear-cli
dev-dependencies: []
