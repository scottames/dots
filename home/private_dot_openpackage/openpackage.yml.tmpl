name: scta
{{- $packageRoot := joinPath .home.src_github_dir ".agents/main/packages" }}
{{- $packageNames := list
  "ctx7"
  "gh-stack"
  "global"
  "herdr"
  "humanlayer"
  "ponytail"
  "worktrunk"
}}
{{- $packages := list }}
{{- range $name := $packageNames }}
{{- $packagePath := joinPath $packageRoot $name }}
{{- if stat $packagePath }}
{{- $packages = append $packages (dict "name" $name "base" $packagePath) }}
{{- end }}
{{- end }}
dependencies:{{ if not $packages }} []{{ end }}
{{- range $package := $packages }}
- name: {{ $package.name }}
  base: {{ $package.base }}
{{- end }}
dev-dependencies: []
