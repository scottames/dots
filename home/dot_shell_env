#!/usr/bin/env bash
# vi: ft=bash

# Sourced by non-interactive Bash and Zsh. Keep silent and limited to
# PATH/function overrides.

if [[ -z ${MISE_SHIMS_DIR-} ]]; then
  MISE_SHIMS_DIR="${HOME}/.local/share/mise/shims"
fi

home_local_bin="${HOME_LOCAL_BIN:-${HOME}/.local/bin}"

if [[ -d ${MISE_SHIMS_DIR} ]]; then
  path_without_overrides=":${PATH-}:"
  path_without_overrides=${path_without_overrides//:${home_local_bin}:/:}
  path_without_overrides=${path_without_overrides//:${MISE_SHIMS_DIR}:/:}
  path_without_overrides=${path_without_overrides#:}
  path_without_overrides=${path_without_overrides%:}

  if [[ -n ${path_without_overrides} ]]; then
    export PATH="${home_local_bin}:${MISE_SHIMS_DIR}:${path_without_overrides}"
  else
    export PATH="${home_local_bin}:${MISE_SHIMS_DIR}"
  fi
fi

unset home_local_bin path_without_overrides

# Force gh through the token-injecting wrapper even after tools reorder PATH.
function gh() {
  if [[ -x ${HOME}/.local/bin/gh ]]; then
    "${HOME}/.local/bin/gh" "$@"
  else
    command gh "$@"
  fi
}
